########################################################################
########################################################################
# Makefile for misc011
########################################################################
########################################################################
CAT=cat
CPF=cp -f
NPX=npx
NODE=node
PRINTF=printf
PYTHON=python3
########################################################################
########################################################################
all:: test
########################################################################
clean:: ; rm -f *~
########################################################################
cleanall:: ; rm -f *~
cleanall:: ; rm -f OUTS/*_cats.js
cleanall:: ; rm -f OUTS/*_dats.js
cleanall:: ; rm -f OUTS/test_out.js
########################################################################
########################################################################
#
XASSETS=\
./../../../../../xassets
XATS2JS=$(XASSETS)/xats2js
RUNTIME=$(XATS2JS)/srcgen1/runtime
#
XATS2JS_JSEMIT01=\
$(NPX) @npmhwxi/xats2js-jsemit01-ats2
XATS2JS_JSEMIT01=\
$(NPX) @xatshome/xats2js-jsemit01-ats2
#
########################################################################
########################################################################
test:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/$@_out.js
test:: ; \
$(CAT) $(RUNTIME)/xats2js_js1emit.js >> OUTS/$@_out.js
test:: ; \
$(CAT) $(RUNTIME)/srcgen2_precats.js >> OUTS/$@_out.js
test:: ; \
$(CAT) $(RUNTIME)/srcgen2_prelude.js >> OUTS/$@_out.js
test:: ggrph
ggrph: ggrph.dats; $(XATS2JS_JSEMIT01) $< >> OUTS/test_out.js
test:: doublets
doublets: doublets.dats; $(XATS2JS_JSEMIT01) $< >> OUTS/test_out.js
########################################################################
embedded:: ; \
$(CPF) JS_doublets.cats OUTS/JS_doublets_cats.js
embedded:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/JS_doublets_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/xats2js_js1emit.js >> OUTS/JS_doublets_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/srcgen2_precats.js >> OUTS/JS_doublets_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/srcgen2_prelude.js >> OUTS/JS_doublets_dats.js
embedded:: \
doublets.dats ; $(XATS2JS_JSEMIT01) $< >> OUTS/JS_doublets_dats.js
embedded:: \
JS_doublets.dats ; $(XATS2JS_JSEMIT01) $< >> OUTS/JS_doublets_dats.js
