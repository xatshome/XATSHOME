########################################################################
CAT=cat
CPF=cp -f
NPX=npx
NODE=node
PRINTF=printf
PYTHON=python3
########################################################################
########################################################################
all:: test
########################################################################
clean:: ; rm -f *~
########################################################################
cleanall:: ; rm -f *~
cleanall:: ; rm -f OUTS/*_cats.js
cleanall:: ; rm -f OUTS/*_dats.js
cleanall:: ; rm -f OUTS/test_out.js
########################################################################
########################################################################
#
XASSETS=\
./../../../../../xassets
XATS2JS=$(XASSETS)/xats2js
RUNTIME=$(XATS2JS)/srcgen1/runtime
#
XATS2JS_JSEMIT01=\
$(NPX) @npmhwxi/xats2js-jsemit01-ats2
XATS2JS_JSEMIT01=\
$(NPX) @xatshome/xats2js-jsemit01-ats2
#
########################################################################
########################################################################
test:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/$@_out.js
test:: ; \
$(CAT) $(RUNTIME)/xats2js_js1emit.js >> OUTS/$@_out.js
test:: ; \
$(CAT) $(RUNTIME)/srcgen2_precats.js >> OUTS/$@_out.js
test:: ; \
$(CAT) $(RUNTIME)/srcgen2_prelude.js >> OUTS/$@_out.js
test:: Game-of-24.dats; $(XATS2JS_JSEMIT01) $< >> OUTS/$@_out.js
########################################################################
embedded:: ; \
$(CPF) Game-of-24.cats OUTS/Game-of-24_cats.js
embedded:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/Game-of-24_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/xats2js_js1emit.js >> OUTS/Game-of-24_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/srcgen2_precats.js >> OUTS/Game-of-24_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/srcgen2_prelude.js >> OUTS/Game-of-24_dats.js
embedded:: \
Game-of-24_dats
Game-of-24_dats: \
Game-of-24.dats; $(XATS2JS_JSEMIT01) $< >> OUTS/Game-of-24_dats.js
