########################################################################
########################################################################
# Makefile for misc010
########################################################################
########################################################################
CAT=cat
CPF=cp -f
NPX=npx
NODE=node
PRINTF=printf
PYTHON=python3
########################################################################
########################################################################
all:: test
########################################################################
clean:: ; rm -f *~
########################################################################
cleanall:: ; rm -f *~
cleanall:: ; rm -f OUTS/spelling_out.js
cleanall:: ; rm -f OUTS/JS_spelling_out.js
cleanall:: ; rm -f OUTS/JS_spelling_cats.js
cleanall:: ; rm -f OUTS/JS_spelling_dats.js
########################################################################
########################################################################
#
XASSETS=\
./../../../../../xassets
XATS2JS=$(XASSETS)/xats2js
RUNTIME=$(XATS2JS)/srcgen1/runtime
#
XATS2JS_JSEMIT01=\
$(NPX) @npmhwxi/xats2js-jsemit01-ats2
XATS2JS_JSEMIT01=\
$(NPX) @xatshome/xats2js-jsemit01-ats2
#
########################################################################
########################################################################
test:: \
spelling
spelling: \
spelling.dats; $(XATS2JS_JSEMIT01) $< > OUTS/$@_out.js
test:: \
JS_spelling
JS_spelling: \
JS_spelling.dats; $(XATS2JS_JSEMIT01) $< > OUTS/$@_out.js
########################################################################
embedded:: ; \
$(CPF) JS_spelling.cats OUTS/JS_spelling_cats.js
embedded:: ; \
$(PRINTF) "// %s\n" "`date`" > OUTS/JS_spelling_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/xats2js_js1emit.js >> OUTS/JS_spelling_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/srcgen2_precats.js >> OUTS/JS_spelling_dats.js
embedded:: ; \
$(CAT) $(RUNTIME)/srcgen2_prelude.js >> OUTS/JS_spelling_dats.js
embedded:: \
spelling.dats ; $(XATS2JS_JSEMIT01) $< >> OUTS/JS_spelling_dats.js
embedded:: \
JS_spelling.dats ; $(XATS2JS_JSEMIT01) $< >> OUTS/JS_spelling_dats.js
