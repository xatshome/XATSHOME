;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define XATSTOP0 #f)
;;
(define XATSVOID #f)
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define (XATSINT0 i0) i0)
(define (XATSINT1 i0) i0)
;;
(define (XATSBTF0 b0) b0)
(define (XATSBOOL b0) b0)
;;
(define (XATSCNUL) 0)
(define (XATSCHR1) 0)
(define (XATSCHAR c0) c0)
;;
(define
  (XATSCHR0 ch)
  (char->integer (string-ref ch 0)))
(define
  (XATSCHR2 ch)
  (char->integer (string-ref ch 0)))
;;
(define (XATSCHR3 ch)
  (let* ((c1 (string-ref ch 1))
         (d1 (char->integer c1))
         (n1 (string-length ch)))
    (cond
      ;; ord('0') = 48
      ;; ord('7') = 55
      ;; e.g. "\(" or "\)"
      ((< d1 48) d1)
      ((> d1 55) d1)
      ;; "\ddd" : octal
      (else
       (let loop ((i1 2)
                  (ds (- c1 48)))
         (if (>= i1 n1)
             ds ;; (integer->char ds)
             (let* ((c1 (string-ref ch i1))
		    (d1 (char->integer c1)))
               (if (char=? c1 #\')
                   ds ;; (integer->char ds)
                   (loop (+ i1 1)
                         (+ (* 8 ds) (- d1 48)))))))))))
;;
(define (XATSFLT0 f0) f0)
(define (XATSFLT1 f0) f0)
;;
(define (XATSSTR0 cs) cs)
(define (XATSSTRN cs) cs)
;;
(define (XATSSFLT sf) (string->number sf))
(define (XATSDFLT df) (string->number df))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
#|
(define
(XATSCAST name arg1 . args) arg1)
(define
(XATSCAPP name ctag . args) (apply vector ctag args))
|#
(define-syntax XATSCAST
  (syntax-rules () ((_ name arg1 args ...) arg1)))
(define-syntax XATSCAPP
  (syntax-rules ()
    ((_ name ctag args ...) (vector ctag args ...))))
;;
#|
(define
(XATSDAPP dfun . args) (apply dfun args))
|#
(define-syntax XATSDAPP
  (syntax-rules () ((_ dfun args ...) (dfun args ...))))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define
(XATSPFLT tflt offs)
(cond
 ((vector? tflt)
  (vector-ref tflt offs))
 (else
  (let srch ((kxs tflt))
    (if (pair? kxs)
	(let ((kx (car kxs)))
	  (if (eq? (car kx) offs)
	      (cdr kx) (srch (cdr kxs)))) #f)))))
;;
(define
(XATSPROJ tbox offs)
(cond
 ((vector? tbox)
  (vector-ref tbox offs))
 (else
  (let srch ((kxs tbox))
    (if (pair? kxs)
	(let ((kx (car kxs)))
	  (if (eq? (car kx) offs)
	      (cdr kx) (srch (cdr kxs)))) #f))))
)
;;
(define
(XATSP0RJ p0rj offs) (vector-ref p0rj offs))
(define
(XATSP1RJ _ p1rj offs) (vector-ref p1rj offs))
;;
(define
(XATSPCON pcon argi)
(let ((offs (+ argi 1))) (vector-ref pcon offs)))
;;
(define
(XATSP1CN tknd p1cn offs) (vector-ref p1cn offs))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define (XATSTRCD knd0) knd0)
;;
(define
(XATSTUP0 . tpl0) (apply vector tpl0))
(define
(XATSTUP1 tknd . tpl1) (apply vector tpl1))
;;
(define (XATSRCD2 tknd . rcd2) (apply list rcd2))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define (XATSROOT x) (vector 0 x))
(define (XATSLPFT i x) (vector (+ 1 0) x i))
(define (XATSLPBX i x) (vector (+ 1 1) x i))
(define (XATSLPCN i x) (vector (+ 1 2) x (+ i 1)))
;;
(define (XATSVAR0) (XATSROOT (vector #f)))
(define (XATSVAR1 init) (XATSROOT (vector init)))
;;
(define (XATSADDR addr) addr)
(define (XATSFLAT addr) (XATS000_lvget addr))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define-syntax XATSLAM0
  (syntax-rules () ((_ f) f)))
(define-syntax XATSFIX0
  (syntax-rules () ((_ f fdef) (letrec ((f fdef)) f))))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define (XATSCTAG _ t) t)
;;
(define (XATS000_inteq x y) (= x y))
(define (XATS000_chreq x y) (= x y))
(define (XATS000_btfeq x y) (eq? x y))
;;
(define (XATS000_streq x y) (string=? x y))
(define (XATS000_ctgeq v t) (= (vector-ref v 0) t))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define
  (XATS2CM_optn_nil)
  (XATSCAPP "optn_nil" 0))
(define
  (XATS2CM_optn_cons x0)
  (XATSCAPP "optn_cons" 1 x0))
;;
(define
  (XATS2CM_list_nil)
  (XATSCAPP "list_nil" 0))
(define
  (XATS2CM_list_cons x0 xs)
  (XATSCAPP "list_cons" 1 x0 xs))
;;
(define
  (XATS2CM_optn_vt_nil)
  (XATSCAPP "optn_vt_nil" 0))
(define
  (XATS2CM_optn_vt_cons x0)
  (XATSCAPP "optn_vt_cons" 1 x0))
;;
(define
  (XATS2CM_list_vt_nil)
  (XATSCAPP "list_vt_nil" 0))
(define
  (XATS2CM_list_vt_cons x0 xs)
  (XATSCAPP "list_vt_cons" 1 x0 xs))
