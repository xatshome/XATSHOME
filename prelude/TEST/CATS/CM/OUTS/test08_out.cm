(define
 (XATS2CM_a1sz_length A0) (vector-length A0))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define
 (XATS2CM_a1sz_lget$at A0 i0) (vector-ref A0 i0))
(define
 (XATS2CM_a1sz_lset$at A0 i0 x1) (vector-set! A0 i0 x1))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define
 (XATS2CM_a1sz_make_ncpy n0 x0) (make-vector n0 x0))
;;
(define
 (XATS2CM_a1sz_make_nfun n0 fopr)
 (let loop
     ((i0 0)
      (A0 (make-vector n0 #f)))
   (if (>= i0 n0) A0
       (begin (vector-set! A0 i0 (fopr i0)) (loop (+ i0 1) A0)))))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define
 (XATS2CM_a1sz_make_fwork fwork)
 (let ((xs '())) 
   (begin
     (fwork (lambda (x0) (set! xs (cons x0 xs))))
     (list->vector (reverse! xs)))))
;;
